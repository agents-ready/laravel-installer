{
  "name": "agents-ready/laravel-installer",
  "description": "Install Agent-Ready Laravel local-development tooling into Laravel applications.",
  "keywords": [
    "agent-ready",
    "docker",
    "frankenphp",
    "laravel",
    "local-development",
    "worktrees"
  ],
  "license": "MIT",
  "homepage": "https://github.com/agents-ready/laravel-installer",
  "support": {
    "issues": "https://github.com/agents-ready/laravel-installer/issues",
    "source": "https://github.com/agents-ready/laravel-installer"
  },
  "authors": [
    {
      "name": "Edgar Sedov"
    }
  ],
  "require": {
    "php": "^8.3",
    "illuminate/console": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0"
  },
  "require-dev": {
    "laravel/pint": "^1.25",
    "orchestra/testbench": "^10.0|^11.0",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5|^12.0",
    "symfony/process": "^7.0|^8.0"
  },
  "autoload": {
    "psr-4": {
      "EdgarSedov\\AgentReadyInstaller\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "EdgarSedov\\AgentReadyInstaller\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "EdgarSedov\\AgentReadyInstaller\\AgentReadyInstallerServiceProvider"
      ]
    }
  },
  "scripts": {
    "analyse": "phpstan analyse --ansi --memory-limit=1G",
    "format": "pint",
    "format:test": "pint --test",
    "test": "phpunit --colors=always"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}

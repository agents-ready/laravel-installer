name: ${COMPOSE_PROJECT_NAME:-{{ slug }}}

services:
  app:
    build:
      context: ./{{ docker_path }}/php-fpm
    working_dir: /app
    volumes:
      - .:/app
    networks:
      - default
      - shared-services

  nginx:
    image: nginx:1.27.4
    depends_on:
      - app
    volumes:
      - .:/app:ro
      - ./{{ docker_path }}/nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
    networks:
      - default
      - traefik-public
    labels:
      - traefik.enable=true
      - traefik.docker.network=traefik-public
      - traefik.http.routers.${AGENTS_READY_APP_ROUTER:-{{ slug }}}.entrypoints=websecure
      - traefik.http.routers.${AGENTS_READY_APP_ROUTER:-{{ slug }}}.rule=Host(`${AGENTS_READY_APP_HOST:-{{ app_host }}}`)
      - traefik.http.routers.${AGENTS_READY_APP_ROUTER:-{{ slug }}}.service=${AGENTS_READY_APP_SERVICE:-{{ slug }}}
      - traefik.http.routers.${AGENTS_READY_APP_ROUTER:-{{ slug }}}.tls=true
      - traefik.http.services.${AGENTS_READY_APP_SERVICE:-{{ slug }}}.loadbalancer.server.port=80

  vite:
    image: node:24.11.1
    working_dir: /app
    command: npm run dev -- --host 0.0.0.0
    profiles:
      - frontend
    volumes:
      - .:/app
    networks:
      - default
      - traefik-public
    labels:
      - traefik.enable=true
      - traefik.docker.network=traefik-public
      - traefik.http.routers.${AGENTS_READY_VITE_ROUTER:-{{ slug }}-vite}.entrypoints=websecure
      - traefik.http.routers.${AGENTS_READY_VITE_ROUTER:-{{ slug }}-vite}.rule=Host(`${AGENTS_READY_VITE_HOST:-{{ vite_host }}}`)
      - traefik.http.routers.${AGENTS_READY_VITE_ROUTER:-{{ slug }}-vite}.service=${AGENTS_READY_VITE_SERVICE:-{{ slug }}-vite}
      - traefik.http.routers.${AGENTS_READY_VITE_ROUTER:-{{ slug }}-vite}.tls=true
      - traefik.http.services.${AGENTS_READY_VITE_SERVICE:-{{ slug }}-vite}.loadbalancer.server.port=5173
{{ horizon_service }}

networks:
  shared-services:
    name: shared-services
    external: true
  traefik-public:
    external: true

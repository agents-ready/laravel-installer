FROM php:8.4.15-fpm

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        unzip{{ database_packages }} \
    && docker-php-ext-install {{ database_extension }} \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2.9.2 /usr/bin/composer /usr/bin/composer

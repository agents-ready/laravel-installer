#!/usr/bin/env bash

link_agents() {
  mkdir -p .agents/skills

  if [[ -d .ai/skills ]]; then
    for skill in .ai/skills/*; do
      [[ -d "${skill}" ]] || continue
      local name
      name=$(basename "${skill}")
      if [[ ! -e ".agents/skills/${name}" ]]; then
        ln -s "../../.ai/skills/${name}" ".agents/skills/${name}"
      fi
    done
  fi

  for tool in .claude .cursor; do
    mkdir -p "${tool}"
    if [[ ! -e "${tool}/skills" ]]; then
      ln -s ../.agents/skills "${tool}/skills"
    elif [[ ! -L "${tool}/skills" ]]; then
      echo "Skipping ${tool}/skills because it already exists and is not a symlink." >&2
    fi
  done
}

agents_ready_convention_usage() {
  cat >&2 <<'USAGE'
  agents link                Link local agent skill activation folders
USAGE
}

agents_ready_handle_convention_command() {
  local cmd="$1"
  shift || true

  case "$cmd" in
    agents)
      local sub=${1:-}
      shift || true
      case "$sub" in
        link)
          link_agents
          ;;
        *)
          echo "Usage: ./local agents link" >&2
          exit 2
          ;;
      esac
      return 0
      ;;
  esac

  return 1
}

agents_ready_after_worktree_create() {
  local target="$1"

  (cd "$target" && ./local agents link)
}

#!/usr/bin/env bash

compose=(docker compose --file docker-compose.yml)
state_file=".agents-ready/worktree.json"
index_file=".agents-ready/worktrees.json"

json_escape() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  printf '%s' "$value"
}

json_value() {
  local file="$1"
  local key="$2"

  [[ -f "$file" ]] || return 0

  awk -F'"' -v key="$key" '
    $2 == key {
      value = $0
      sub(/^[^:]*:[[:space:]]*/, "", value)
      sub(/,[[:space:]]*$/, "", value)
      sub(/^"/, "", value)
      sub(/"$/, "", value)
      gsub(/\\"/, "\"", value)
      gsub(/\\\\/, "\\", value)
      print value
      exit
    }
  ' "$file"
}

slugify() {
  local value="$1"

  value="$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//; s/-+/-/g')"

  if [[ -z "$value" ]]; then
    value="worktree"
  fi

  printf '%s' "${value:0:48}"
}

db_slug() {
  printf '%s' "$1" | tr '-' '_'
}

checkout_namespace() {
  local project_id="$1"
  local worktree_id="$2"

  if [[ "$project_id" == "$worktree_id" ]]; then
    db_slug "$project_id"
  else
    printf '%s_%s' "$(db_slug "$project_id")" "$(db_slug "$worktree_id")"
  fi
}

current_root() {
  pwd -P
}

main_worktree() {
  local configured

  configured="$(json_value "$state_file" "mainWorktree")"
  if [[ -n "$configured" && -d "$configured" ]]; then
    printf '%s\n' "$configured"
    return 0
  fi

  git worktree list --porcelain 2>/dev/null | awk '/^worktree / { print substr($0, 10); exit }' || true
}

main_state_file() {
  printf '%s/.agents-ready/worktree.json\n' "$(main_worktree)"
}

state_value_or_default() {
  local key="$1"
  local fallback="$2"
  local value

  value="$(json_value "$state_file" "$key")"
  if [[ -n "$value" ]]; then
    printf '%s\n' "$value"
    return 0
  fi

  printf '%s\n' "$fallback"
}

main_state_value_or_default() {
  local key="$1"
  local fallback="$2"
  local state
  local value

  state="$(main_state_file)"
  value="$(json_value "$state" "$key")"
  if [[ -n "$value" ]]; then
    printf '%s\n' "$value"
    return 0
  fi

  printf '%s\n' "$fallback"
}

project_slug() {
  local slug

  slug="$(json_value "$(main_state_file)" "projectId")"
  if [[ -z "$slug" ]]; then
    slug="$(json_value "$state_file" "projectId")"
  fi
  if [[ -z "$slug" ]]; then
    slug="$(json_value "$(main_state_file)" "worktreeId")"
  fi
  if [[ -z "$slug" ]]; then
    slug="$(json_value "$state_file" "worktreeId")"
  fi
  if [[ -z "$slug" ]]; then
    slug="$(slugify "$(basename "$(current_root)")")"
  fi

  printf '%s\n' "$slug"
}

load_worktree_env() {
  local default_slug
  local project_id
  local worktree_id
  local route_domain
  local compose_project

  default_slug="$(slugify "$(basename "$(current_root)")")"
  project_id="$(state_value_or_default "projectId" "$(main_state_value_or_default "projectId" "$default_slug")")"
  worktree_id="$(state_value_or_default "worktreeId" "$project_id")"
  route_domain="$(state_value_or_default "routeDomain" "$(main_state_value_or_default "routeDomain" "$project_id.localhost")")"
  compose_project="$(checkout_namespace "$project_id" "$worktree_id")"

  export AGENTS_READY_PROJECT_ID
  export AGENTS_READY_WORKTREE_ID
  export AGENTS_READY_RUNTIME
  export AGENTS_READY_DATABASE_ENGINE
  export AGENTS_READY_COMPOSE_PROJECT
  export AGENTS_READY_HORIZON
  export COMPOSE_PROJECT_NAME
  export AGENTS_READY_APP_ROUTER
  export AGENTS_READY_APP_SERVICE
  export AGENTS_READY_APP_HOST
  export AGENTS_READY_VITE_ROUTER
  export AGENTS_READY_VITE_SERVICE
  export AGENTS_READY_VITE_HOST

  AGENTS_READY_PROJECT_ID="$project_id"
  AGENTS_READY_WORKTREE_ID="$worktree_id"
  AGENTS_READY_RUNTIME="$(state_value_or_default "runtime" "frankenphp")"
  AGENTS_READY_DATABASE_ENGINE="$(state_value_or_default "databaseEngine" "pgsql")"
  AGENTS_READY_HORIZON="$(state_value_or_default "horizon" "false")"
  AGENTS_READY_COMPOSE_PROJECT="$compose_project"
  COMPOSE_PROJECT_NAME="$compose_project"
  unset HORIZON_PREFIX
  AGENTS_READY_APP_ROUTER="$compose_project"
  AGENTS_READY_APP_SERVICE="$compose_project"

  if [[ "$project_id" == "$worktree_id" ]]; then
    AGENTS_READY_APP_HOST="$route_domain"
    AGENTS_READY_VITE_HOST="vite.$route_domain"
  else
    AGENTS_READY_APP_HOST="$worktree_id.$route_domain"
    AGENTS_READY_VITE_HOST="vite-$worktree_id.$route_domain"
  fi

  AGENTS_READY_VITE_ROUTER="$compose_project-vite"
  AGENTS_READY_VITE_SERVICE="$compose_project-vite"
}

compose_run() {
  load_worktree_env
  "${compose[@]}" "$@"
}

compose_exec() {
  local tty_args=()

  load_worktree_env
  if [[ ! -t 0 ]]; then
    tty_args=(-T)
  fi

  "${compose[@]}" exec "${tty_args[@]}" "$@"
}

compose_for_root() {
  local root="$1"
  shift

  (
    cd "$root"
    load_worktree_env
    docker compose --file docker-compose.yml "$@"
  )
}

docker_available() {
  command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1
}

configured_companion_home() {
  local config_file="$1"
  local key="$2"
  local configured

  configured="$(json_value "$config_file" "$key")"
  if [[ -n "$configured" && -x "$configured/bin/ensure" ]]; then
    printf '%s\n' "$configured"
    return 0
  fi

  return 1
}

discover_companion_home() {
  local key="$1"
  local sibling_name="$2"
  local main
  local root
  local sibling

  if [[ -f .agents-ready/config.json ]] && configured_companion_home .agents-ready/config.json "$key"; then
    return 0
  fi

  main="$(main_worktree)"
  if [[ -n "$main" && "$main" != "$(current_root)" && -f "$main/.agents-ready/config.json" ]] && configured_companion_home "$main/.agents-ready/config.json" "$key"; then
    return 0
  fi

  for root in "${main:-}" "$(current_root)"; do
    [[ -n "$root" ]] || continue
    sibling="$(dirname "$root")/$sibling_name"
    if [[ -x "$sibling/bin/ensure" ]]; then
      printf '%s\n' "$sibling"
      return 0
    fi
  done

  if [[ -x "../$sibling_name/bin/ensure" ]]; then
    printf '%s\n' "$(cd "../$sibling_name" && pwd -P)"
    return 0
  fi

  return 1
}

traefik_home() {
  if discover_companion_home "traefikHome" "shared-traefik"; then
    return 0
  fi

  cat >&2 <<'MSG'
Unable to find shared Traefik.
Rerun install with --traefik-home=/path/to/shared-traefik, or keep shared-traefik next to this project.
MSG
  return 1
}

services_home() {
  if discover_companion_home "servicesHome" "shared-services"; then
    return 0
  fi

  cat >&2 <<'MSG'
Unable to find shared services.
Rerun install with --services-home=/path/to/shared-services, or keep shared-services next to this project.
MSG
  return 1
}

ensure_shared_services() {
  local services_dir

  load_worktree_env
  services_dir="$(services_home)" || return $?
  "$services_dir/bin/ensure" --database="$AGENTS_READY_DATABASE_ENGINE" --cache=valkey
}

provision_shared_databases() {
  local services_dir

  load_worktree_env
  services_dir="$(services_home)" || return $?
  "$services_dir/bin/provision-checkout" \
    --project-id="$AGENTS_READY_PROJECT_ID" \
    --worktree-id="$AGENTS_READY_WORKTREE_ID" \
    --database="$AGENTS_READY_DATABASE_ENGINE" \
    --root="$(current_root)"
}

derive_shared_checkout_env() {
  local services_dir

  load_worktree_env
  services_dir="$(services_home)" || return $?
  "$services_dir/bin/derive-checkout" \
    --project-id="$AGENTS_READY_PROJECT_ID" \
    --worktree-id="$AGENTS_READY_WORKTREE_ID" \
    --database="$AGENTS_READY_DATABASE_ENGINE" \
    --format=env
}

cleanup_shared_databases() {
  local services_dir

  load_worktree_env
  services_dir="$(services_home)" || return $?
  "$services_dir/bin/drop-checkout" \
    --project-id="$AGENTS_READY_PROJECT_ID" \
    --worktree-id="$AGENTS_READY_WORKTREE_ID" \
    --database="$AGENTS_READY_DATABASE_ENGINE"
}

cleanup_shared_valkey_namespaces() {
  local services_dir

  load_worktree_env
  services_dir="$(services_home)" || return $?
  "$services_dir/bin/clean-prefix" \
    --project-id="$AGENTS_READY_PROJECT_ID" \
    --worktree-id="$AGENTS_READY_WORKTREE_ID" \
    --kind=valkey
}

cleanup_shared_horizon_namespaces() {
  local services_dir

  load_worktree_env
  services_dir="$(services_home)" || return $?
  "$services_dir/bin/clean-prefix" \
    --project-id="$AGENTS_READY_PROJECT_ID" \
    --worktree-id="$AGENTS_READY_WORKTREE_ID" \
    --kind=horizon
}

ensure_env_file() {
  local target="$1"
  shift
  local source

  [[ -e "$target" ]] && return 0

  for source in "$@"; do
    if [[ -n "$source" && -f "$source" && "$source" != "$target" ]]; then
      cp "$source" "$target"
      return 0
    fi
  done

  touch "$target"
}

materialize_runtime_env() {
  local derived
  local horizon_enabled
  local main

  load_worktree_env
  horizon_enabled="$AGENTS_READY_HORIZON"
  derived="$(mktemp)"
  derive_shared_checkout_env > "$derived"
  unset HORIZON_PREFIX
  set -a
  # shellcheck source=/dev/null
  source "$derived"
  set +a
  rm -f "$derived"

  if [[ "$horizon_enabled" == "true" && -z "${HORIZON_PREFIX:-}" ]]; then
    echo "Horizon is enabled, but shared-services derive-checkout did not provide HORIZON_PREFIX." >&2
    echo "Update shared-services or disable Horizon for this checkout." >&2
    return 1
  fi

  main="$(main_worktree)"
  ensure_env_file ".env" "$main/.env" ".env.example"
  ensure_env_file ".env.testing" "$main/.env.testing" "$main/.env" ".env.testing.example" ".env" ".env.example"

  upsert_env_var ".env" "APP_URL" "https://$AGENTS_READY_APP_HOST"
  upsert_env_var ".env" "DB_CONNECTION" "$DB_CONNECTION"
  upsert_env_var ".env" "DB_HOST" "$DB_HOST"
  upsert_env_var ".env" "DB_PORT" "$DB_PORT"
  upsert_env_var ".env" "DB_DATABASE" "$DB_DATABASE"
  upsert_env_var ".env" "DB_USERNAME" "$DB_USERNAME"
  upsert_env_var ".env" "DB_PASSWORD" "$DB_PASSWORD"
  upsert_env_var ".env" "REDIS_HOST" "$REDIS_HOST"
  upsert_env_var ".env" "REDIS_PREFIX" "$REDIS_PREFIX"
  if [[ "$horizon_enabled" == "true" ]]; then
    upsert_env_var ".env" "HORIZON_PREFIX" "$HORIZON_PREFIX"
  fi
  upsert_env_var ".env" "COMPOSE_PROJECT_NAME" "$COMPOSE_PROJECT_NAME"
  upsert_env_var ".env" "APP_SERVICE" "$APP_SERVICE"

  upsert_env_var ".env.testing" "DB_CONNECTION" "$DB_CONNECTION"
  upsert_env_var ".env.testing" "DB_HOST" "$DB_HOST"
  upsert_env_var ".env.testing" "DB_PORT" "$DB_PORT"
  upsert_env_var ".env.testing" "DB_DATABASE" "$DB_TEST_DATABASE"
  upsert_env_var ".env.testing" "DB_USERNAME" "$DB_USERNAME"
  upsert_env_var ".env.testing" "DB_PASSWORD" "$DB_PASSWORD"
  upsert_env_var ".env.testing" "REDIS_HOST" "$REDIS_HOST"
  upsert_env_var ".env.testing" "REDIS_PREFIX" "$REDIS_PREFIX"
  if [[ "$horizon_enabled" == "true" ]]; then
    upsert_env_var ".env.testing" "HORIZON_PREFIX" "$HORIZON_PREFIX"
  fi
}

upsert_env_var() {
  local file="$1"
  local key="$2"
  local value="$3"
  local tmp

  mkdir -p "$(dirname "$file")"
  touch "$file"
  tmp="$(mktemp)"

  awk -v key="$key" -v value="$value" '
    BEGIN { written = 0 }
    $0 ~ "^" key "=" {
      print key "=" value
      written = 1
      next
    }
    { print }
    END {
      if (! written) {
        print key "=" value
      }
    }
  ' "$file" > "$tmp"

  mv "$tmp" "$file"
}

copy_if_present() {
  local source="$1"
  local target="$2"

  if [[ ! -e "$source" || -e "$target" ]]; then
    return 0
  fi

  mkdir -p "$(dirname "$target")"
  cp -a "$source" "$target"
}

link_if_present() {
  local source="$1"
  local target="$2"

  if [[ ! -e "$source" || -e "$target" || -L "$target" ]]; then
    return 0
  fi

  mkdir -p "$(dirname "$target")"
  ln -s "$source" "$target"
}
